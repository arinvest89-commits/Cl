# ─── Anthropic API ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Model Selection ─────────────────────────────────────────────────────────
# Primary model used by all agents (most capable)
DEFAULT_MODEL=claude-opus-4-6
# Fast model for lightweight tasks
FAST_MODEL=claude-haiku-4-5-20251001

# ─── ACP Server (Agent Communication Protocol) ───────────────────────────────
ACP_HOST=0.0.0.0
ACP_PORT=8765

# ─── External Agent Endpoints (ACP) ──────────────────────────────────────────
# Register your external agents here so the team can collaborate with them
OPENCLAW_URL=http://localhost:8766/acp/receive
PAPERCLIP_URL=http://localhost:8767/acp/receive

# ─── Autonomous Loop ─────────────────────────────────────────────────────────
# How often (in seconds) the orchestrator runs its autonomous review cycle
AUTONOMOUS_LOOP_INTERVAL=60

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
